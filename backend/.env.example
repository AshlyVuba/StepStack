# ---- Required (the server refuses to boot without these; there are NO fallbacks) ----
# Generate: openssl rand -base64 48
PORTFOLIO_SIGNING_KEY=
# Service-to-service key used by the LMS / curriculum sync to call internal endpoints
INTERNAL_API_KEY=
DATABASE_URL=postgres://skills:skills@localhost:5432/skills

# ---- Optional (runtime) ----
# Static pre-compiled 11-language lesson packs (zero live CPU/GPU LLM inference at runtime)
LESSON_PACKS_DIR=./lesson-packs
# Optional Redis cache (if omitted, falls back to in-memory cache)
REDIS_URL=
# Previous signing key, kept during rotation so old links still verify
PORTFOLIO_SIGNING_KEY_PREVIOUS=
PUBLIC_BASE_URL=https://skills.example.org
PORT=3000
GRADER_TIMEOUT_MS=1500
GRADER_POOL_SIZE=2
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_BASE_URL=http://localhost:5173

# ---- Build-time ONLY (never required to run the API in production) ----
# Only used when regenerating pre-translated lesson packs via: npm run build:packs -- --live
# ANTHROPIC_API_KEY=
# TRANSLATION_MODEL=claude-sonnet-5-5
