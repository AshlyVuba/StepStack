{
  "id": "sum-even", "title": "Write sum_even(numbers) that returns the sum of the even numbers in a list",
  "functionName": "sum_even",
  "tests": [
    { "args": [[1, 2, 3, 4]], "expected": 6 },
    { "args": [[]], "expected": 0 },
    { "args": [[7, 9]], "expected": 0 },
    { "args": [[-2, 2, 10]], "expected": 10, "hidden": true },
    { "args": [[100, 1, 3, 200]], "expected": 300, "hidden": true }
  ]
}
